              "pm.test(\"Expected status\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"spare_customer_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete spare customer with no tickets",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/customers/{{spare_customer_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
