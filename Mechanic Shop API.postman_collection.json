            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/service-tickets/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Demo oil change\",\n  \"vin\": \"1HGCM82633A004352\",\n  \"customer_id\": {{customer_id}}\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"ticket_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Assign mechanic",
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{base_url}}/service-tickets/{{ticket_id}}/assign-mechanic/{{mechanic_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
