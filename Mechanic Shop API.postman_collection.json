            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/customers/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo Customer\",\n  \"email\": \"spare{{run_id}}@example.com\",\n  \"phone\": \"s{{run_id}}\",\n  \"address\": \"123 Demo Street\"\n}"
        }
